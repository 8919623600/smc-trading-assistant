3. Deep-Dive into Institutional UpgradesUpgrade B: Optimal Trade Entry (OTE) Zone (0.618 – 0.79 Fib Retracement)The Concept: Institutional traders rarely buy at the exact high or sell at the exact low of a dealing range. They wait for a deep pullback into the discount array (for bullish setups) or premium array (for bearish setups).The Math:Total Range ($\text{Span}$) = $\text{Recent High} - \text{Recent Low}$Bullish OTE Zone: Retracement between 61.8% and 79.0% down from the high.$$\text{OTE Bullish High} = \text{Recent High} - (\text{Span} \times 0.618)$$$$\text{OTE Bullish Low} = \text{Recent High} - (\text{Span} \times 0.790)$$Bearish OTE Zone: Retracement between 61.8% and 79.0% up from the low.Execution Gate: If price has not retraced deep enough into this sweet spot, the engine flags WAIT to prevent entering too early while price is still bleeding.Upgrade C: True Institutional Displacement FilterThe Concept: Not all breakouts or structure shifts are genuine. Retail breakouts often trap traders on tiny-bodied candles with massive wicks (showing rejection). Institutional displacement must look aggressive.The Logic:The engine calculates the average body size of the last 15 candles on the 15-minute timeframe.The latest candle body must be at least 1.3x larger than the historical average body size.If the candle has a tiny body and a large rejection wick, the engine rejects the trade instantly (WAIT).4. Full Script ModulesModule A: googlesmc.py (The Core Engine)Pythonfrom datetime import datetime, timedelta
from zoneinfo import ZoneInfo
import numpy as np
import pandas as pd

# Global IST Timezone Definition
IST = ZoneInfo("Asia/Kolkata")

def get_current_ist_time():
    return datetime.now(IST).strftime("%Y-%m-%d %I:%M:%S %p IST")

class SMCTradingEngine:
    def __init__(self, min_rr=1.5, max_rr=8.0, atr_multiplier=0.3, news_buffer_mins=15):
        self.min_rr = min_rr
        self.max_rr = max_rr
        self.atr_multiplier = atr_multiplier
        self.news_buffer_mins = news_buffer_mins

    @staticmethod
    def calculate_atr(df: pd.DataFrame, period: int = 14) -> pd.Series:
        high_low = df["high"] - df["low"]
        high_close = (df["high"] - df["close"].shift()).abs()
        low_close = (df["low"] - df["close"].shift()).abs()
        ranges = pd.concat([high_low, high_close, low_close], axis=1)
        true_range = ranges.max(axis=1)
        return true_range.rolling(period).mean()

    @staticmethod
    def find_pivots(df: pd.DataFrame, length: int = 2):
        df = df.copy()
        df["pivot_high"] = np.nan
        df["pivot_low"] = np.nan

        for i in range(length, len(df) - length):
            window = df.iloc[i - length : i + length + 1]
            if df["high"].iloc[i] == window["high"].max():
                df.iloc[i, df.columns.get_loc("pivot_high")] = df["high"].iloc[i]
            if df["low"].iloc[i] == window["low"].min():
                df.iloc[i, df.columns.get_loc("pivot_low")] = df["low"].iloc[i]
        return df

    @staticmethod
    def check_displacement(df_15m: pd.DataFrame) -> bool:
        """UPGRADE C: Validates institutional momentum vs. retail trap wicks."""
        if len(df_15m) < 10:
            return True
        bodies = (df_15m["close"] - df_15m["open"]).abs()
        avg_body = bodies.iloc[-15:-1].mean()
        latest_body = bodies.iloc[-1]
        return latest_body >= (1.3 * avg_body)

    def get_4h_bias_and_ote(self, df_4h: pd.DataFrame) -> dict:
        """UPGRADE B: 4H Market Bias & 0.618 - 0.79 OTE Zone Analysis."""
        df = self.find_pivots(df_4h, length=5)
        recent_high = df["pivot_high"].dropna().iloc[-1] if not df["pivot_high"].dropna().empty else df["high"].max()
        recent_low = df["pivot_low"].dropna().iloc[-1] if not df["pivot_low"].dropna().empty else df["low"].min()

        total_range = recent_high - recent_low
        equilibrium = (recent_high + recent_low) / 2
        current_close = df["close"].iloc[-1]

        # OTE Zone Boundaries
        ote_bullish_high = recent_high - (total_range * 0.618)
        ote_bullish_low = recent_high - (total_range * 0.790)
        ote_bearish_low = recent_low + (total_range * 0.618)
        ote_bearish_high = recent_low + (total_range * 0.790)

        in_bullish_ote = ote_bullish_low <= current_close <= ote_bullish_high
        in_bearish_ote = ote_bearish_low <= current_close <= ote_bearish_high

        if current_close < equilibrium:
            bias = "BULLISH"
            in_ote = in_bullish_ote
        elif current_close > equilibrium:
            bias = "BEARISH"
            in_ote = in_bearish_ote
        else:
            bias = "NEUTRAL"
            in_ote = False

        return {
            "bias": bias,
            "in_ote": in_ote,
            "recent_high": recent_high,
            "recent_low": recent_low,
            "equilibrium": equilibrium,
        }

    def check_1h_liquidity_sweep(self, df_1h: pd.DataFrame, bias: str) -> dict:
        df = self.find_pivots(df_1h, length=2)
        swing_highs = df["pivot_high"].dropna()
        swing_lows = df["pivot_low"].dropna()

        last_low = swing_lows.iloc[-1] if not swing_lows.empty else df["low"].min()
        last_high = swing_highs.iloc[-1] if not swing_highs.empty else df["high"].max()
        current_bar = df.iloc[-1]

        swept, sweep_type, sweep_level = False, "NONE", None

        if bias == "BULLISH" and last_low:
            if current_bar["low"] < last_low and current_bar["close"] > last_low:
                swept, sweep_type, sweep_level = True, "BULLISH", current_bar["low"]
        elif bias == "BEARISH" and last_high:
            if current_bar["high"] > last_high and current_bar["close"] < last_high:
                swept, sweep_type, sweep_level = True, "BEARISH", current_bar["high"]

        return {"swept": swept, "type": sweep_type, "sweep_level": sweep_level, "h1_sh": last_high, "h1_sl": last_low}

    def detect_15m_poi(self, df_15m: pd.DataFrame, sweep_info: dict) -> dict:
        if not sweep_info["swept"]:
            return {"valid_poi": False}

        df = self.find_pivots(df_15m, length=2)
        m15_sh = df["pivot_high"].dropna().iloc[-1] if not df["pivot_high"].dropna().empty else df["high"].max()
        m15_sl = df["pivot_low"].dropna().iloc[-1] if not df["pivot_low"].dropna().empty else df["low"].min()

        fvg_found, fvg_top, fvg_bottom = False, None, None
        start_idx = len(df) - 3
        end_idx = max(2, len(df) - 10)

        for i in range(start_idx, end_idx, -1):
            if sweep_info["type"] == "BULLISH" and df["low"].iloc[i] > df["high"].iloc[i - 2]:
                fvg_found, fvg_top, fvg_bottom = True, df["low"].iloc[i], df["high"].iloc[i - 2]
                break
            elif sweep_info["type"] == "BEARISH" and df["high"].iloc[i] < df["low"].iloc[i - 2]:
                fvg_found, fvg_top, fvg_bottom = True, df["low"].iloc[i - 2], df["high"].iloc[i]
                break

        retested = fvg_found and ((sweep_info["type"] == "BULLISH" and df["low"].iloc[-1] <= fvg_top) or 
                                  (sweep_info["type"] == "BEARISH" and df["high"].iloc[-1] >= fvg_bottom))

        return {"valid_poi": retested, "fvg_top": fvg_top, "fvg_bottom": fvg_bottom, "m15_sh": m15_sh, "m15_sl": m15_sl}

    def evaluate_1m_entry(self, df_1m: pd.DataFrame, sweep_info: dict, poi_info: dict) -> dict:
        if not poi_info["valid_poi"]:
            return {"action": "NO_TRADE", "reason": "No valid 15M POI retest"}

        df = df_1m.copy()
        df["atr"] = self.calculate_atr(df, 14)
        current_bar = df.iloc[-1]
        atr_val = current_bar["atr"] if not pd.isna(current_bar["atr"]) else 0.0001
        entry_price = current_bar["close"]

        if sweep_info["type"] == "BULLISH":
            stop_loss = min(poi_info["m15_sl"], sweep_info["h1_sl"]) - (atr_val * self.atr_multiplier)
            risk = entry_price - stop_loss
            if risk <= 0: return {"action": "WAIT", "reason": "Invalid risk"}
            tp1 = entry_price + (risk * 1.5)
            tp2 = sweep_info["h1_sh"] if sweep_info["h1_sh"] > entry_price else entry_price + (risk * 2.0)
            rr_tp2 = (tp2 - entry_price) / risk
            if self.min_rr <= rr_tp2 <= self.max_rr:
                return {"action": "BUY", "entry": round(entry_price, 5), "sl": round(stop_loss, 5), "tp1": round(tp1, 5), "tp2": round(tp2, 5), "rr": round(rr_tp2, 2)}

        elif sweep_info["type"] == "BEARISH":
            stop_loss = max(poi_info["m15_sh"], sweep_info["h1_sh"]) + (atr_val * self.atr_multiplier)
            risk = stop_loss - entry_price
            if risk <= 0: return {"action": "WAIT", "reason": "Invalid risk"}
            tp1 = entry_price - (risk * 1.5)
            tp2 = sweep_info["h1_sl"] if sweep_info["h1_sl"] < entry_price else entry_price - (risk * 2.0)
            rr_tp2 = (entry_price - tp2) / risk
            if self.min_rr <= rr_tp2 <= self.max_rr:
                return {"action": "SELL", "entry": round(entry_price, 5), "sl": round(stop_loss, 5), "tp1": round(tp1, 5), "tp2": round(tp2, 5), "rr": round(rr_tp2, 2)}

        return {"action": "WAIT", "reason": "R:R out of bounds"}

    def analyze(self, data_dict: dict, news_events: list = None) -> dict:
        df_1m = data_dict["1M"]
        df_15m = data_dict["15M"]
        current_time = df_1m.index[-1] if "time" not in df_1m.columns else df_1m.iloc[-1]["time"]

        market_context = self.get_4h_bias_and_ote(data_dict["4H"])
        bias = market_context["bias"]
        if bias == "NEUTRAL": return {"decision": "NO_TRADE", "reason": "4H Neutral"}

        if not market_context["in_ote"]:
            return {"decision": "WAIT", "reason": "Price not in 0.618-0.79 OTE Zone"}

        sweep = self.check_1h_liquidity_sweep(data_dict["1H"], bias)
        if not sweep["swept"]: return {"decision": "WAIT", "reason": "No 1H Liquidity Sweep"}

        poi = self.detect_15m_poi(df_15m, sweep)
        if not poi["valid_poi"]: return {"decision": "WAIT", "reason": "15M POI unconfirmed"}

        if not self.check_displacement(df_15m):
            return {"decision": "WAIT", "reason": "Blocked: Lacks institutional displacement momentum"}

        entry = self.evaluate_1m_entry(df_1m, sweep, poi)
        return {
            "decision": entry["action"],
            "bias_4h": bias,
            "liquidity_sweep": sweep["type"],
            "trade_params": entry if entry["action"] in ["BUY", "SELL"] else None,
            "timestamp": str(current_time)
        }
